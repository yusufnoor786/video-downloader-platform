{\n  "manifest_version": 3,\n  "name": "Video Downloader Platform",\n  "version": "1.0.0",\n  "description": "Advanced video downloader with real-time detection and quality selection",\n  "permissions": [\n    "activeTab",\n    "scripting",\n    "downloads",\n    "storage",\n    "tabs",\n    "webNavigation"\n  ],\n  "host_permissions": [\n    "<all_urls>"\n  ],\n  "background": {\n    "service_worker": "js/background.js"\n  },\n  "content_scripts": [\n    {\n      "matches": ["<all_urls>"],\n      "js": ["js/content.js"],\n      "run_at": "document_start",\n      "all_frames": true\n    }\n  ],\n  "action": {\n    "default_popup": "popup.html",\n    "default_title": "Video Downloader Platform"\n  },\n  "options_page": "options.html",\n  "minimum_chrome_version": "88"\n}\n